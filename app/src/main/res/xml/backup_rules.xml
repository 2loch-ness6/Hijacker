<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include app preferences -->
    <include domain="sharedpref" path="."/>
    
    <!-- Include custom actions -->
    <include domain="file" path="custom_actions"/>
    
    <!-- Exclude sensitive files -->
    <exclude domain="file" path="captured_handshakes"/>
    <exclude domain="file" path="bin"/>
    <exclude domain="file" path="lib"/>
</full-backup-content>
